{
  "name": "@app/web",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "bun run i18n && tsc -p .",
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-prerender.tsx --outDir dist-ssr && bun scripts/prerender.ts",
    "preview": "vite preview --port 4173 --strictPort",
    "e2e": "bun run i18n && playwright test",
    "cap:sync": "cap sync",
    "android:debug": "cap sync android && cd android && ./gradlew assembleDebug --no-daemon -q",
    "check:worker": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --env staging",
    "i18n": "bun scripts/i18n.ts"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "@capacitor/core": "^8.5.2",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@solidjs/router": "^1.0.0",
    "better-auth": "^1.7.5",
    "hono": "^4.13.8",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@app/api": "workspace:*",
    "@app/testing": "workspace:*",
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@inlang/paraglide-js": "^2.25.4",
    "@playwright/test": "^1.63.0",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.14",
    "wrangler": "^4.136.3"
  }
}
