{
  "name": "factory-template",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "verify": "bun scripts/verify.ts",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test:unit": "bun test ./packages/shared ./apps/web/src",
    "test:int": "bun test ./apps/api/test",
    "db:generate": "bun run --cwd packages/db generate",
    "db:check": "bun run --cwd packages/db check",
    "e2e": "bun run --cwd apps/web e2e",
    "build": "bun run --cwd apps/api build && bun run --cwd apps/web build",
    "android": "bun run --cwd apps/web android:debug",
    "infra:check": "bash infra/check.sh",
    "backup:test": "bash deploy/backup/test-restore.sh",
    "dev": "bun run --filter '@app/api' --filter '@app/web' dev"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "latest",
    "typescript": "latest"
  }
}
